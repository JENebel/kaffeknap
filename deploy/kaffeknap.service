[Unit]
Description=Kaffeknap coffee button
After=network-online.target
Wants=network-online.target

[Service]
User=kaffeknap
Group=kaffeknap
# Creates /var/lib/kaffeknap owned by the service user.
StateDirectory=kaffeknap
WorkingDirectory=/var/lib/kaffeknap
ExecStart=/opt/kaffeknap/kaffeknap
Environment=KAFFE_BIND=127.0.0.1:8080
Environment=KAFFE_DB=/var/lib/kaffeknap/kaffeknap.db
Environment=KAFFE_STATIC=/opt/kaffeknap/static
# Only works behind HTTPS. Set to false if you test over plain http://<ip>.
Environment=KAFFE_SECURE_COOKIES=true
Environment=KAFFE_VAPID_SUBJECT=mailto:you@example.com
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
# Extra hardening. These can fail in unprivileged LXC containers without
# "nesting" enabled (status=226/NAMESPACE); remove them if that happens.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kaffeknap

[Install]
WantedBy=multi-user.target
